ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Envio de logs a New Relic (opcional). Sin URL no se envia nada.
# La clave sale de OTEL_EXPORTER_OTLP_HEADERS salvo que se defina LOG_SHIP_API_KEY.
# LOG_SHIP_URL=https://log-api.newrelic.com/log/v1
# LOG_SHIP_API_KEY=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# "disable" en local; "require" cuando la DB es Supabase.
DATABASE_SSLMODE=disable
# Vacio en local (usa el search_path por defecto). En Supabase, el schema
# dedicado del servicio dentro del proyecto compartido, ej: identify
DATABASE_SCHEMA=

JWT_SECRET=

# Clave con la que se cifra el secreto TOTP del segundo factor antes de
# guardarlo. Si se deja vacía se usa JWT_SECRET.
#
# Ojo al rotarla: los secretos ya guardados se cifraron con la anterior y
# dejan de poder descifrarse, así que todos los usuarios con 2FA activo
# quedarían afuera y tendrían que volver a activarlo. Lo mismo vale para
# cambiar JWT_SECRET mientras esta variable esté vacía.
TWO_FACTOR_ENCRYPTION_KEY=

RABBITMQ_URL=
# Secreto HMAC compartido con discordia-admin (el mismo valor en ambos): con él
# se verifica la firma de admin.user_suspended / admin.user_reactivated. Es
# OBLIGATORIO cuando RABBITMQ_URL esta seteada (si falta, el servicio no
# arranca). Lo carga el equipo en el entorno; no se genera ni se commitea.
ADMIN_EVENTS_HMAC_SECRET=

# Secreto HMAC compartido con discordia-billing (el mismo valor en billing,
# identify y messaging): con él se verifica la firma de billing.premium_updated.
# Si falta, no arranca el consumer de billing y el campo premium no se actualiza.
BILLING_EVENTS_HMAC_SECRET=

# Client ID de OAuth 2.0 (tipo "Web application") registrado en Google Cloud
# Console. Debe coincidir con el que usan web-client y app-mobile para pedir
# el ID token (misma audiencia).
GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
APP_NAME=Discordia
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRATION=1h
PASSWORD_RESET_MAX_ATTEMPTS=3
EMAIL_CONFIRMATION_URL=http://localhost:3000/confirm-email
# Opcional. Pagina puente de la web que abre la app mobile (registro desde el
# APK). Si falta, se usa <dominio de EMAIL_CONFIRMATION_URL>/app-link/confirm-email.
# EMAIL_CONFIRMATION_APP_URL=http://localhost:3000/app-link/confirm-email
EMAIL_CONFIRMATION_EXPIRATION=24h
EMAIL_CONFIRMATION_MAX_ATTEMPTS=3
PROFILE_IMAGE_DIR=./storage/profile-images
PROFILE_IMAGE_URL=/uploads/profile-images
# Use "supabase" in production when profile images should live in Supabase Storage.
PROFILE_IMAGE_STORAGE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROFILE_IMAGE_BUCKET=profile-images
# Optional public URL override. By default it is built from SUPABASE_URL and the bucket.
PROFILE_IMAGE_PUBLIC_URL=
