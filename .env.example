ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# "disable" en local; "require" cuando la DB es Supabase.
DATABASE_SSLMODE=disable
# Vacio en local (usa el search_path por defecto). En Supabase, el schema
# dedicado del servicio dentro del proyecto compartido, ej: identify
DATABASE_SCHEMA=

JWT_SECRET=
RABBITMQ_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
APP_NAME=Discordia
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRATION=1h
PASSWORD_RESET_MAX_ATTEMPTS=3
